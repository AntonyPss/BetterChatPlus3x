{
    "namespace": "common_buttons",

    /* Template Button */
    "common_button_template@common_buttons.light_text_button": {
        "$button_offset": [0, -1],
        "$button_pressed_offset": [0, 1],
        "$button_image_size": ["100%", "100%"],
        "$border_visible": false,
        "$default_state_border_visible": false,
        "$hover_state_border_visible": false,
        "$pressed_state_border_visible": false,
        "$locked_state_border_visible": false
    },

    "primary_button@common_button_template": {
        "$default_text_color": "$primary_button_default_text_color",
        "$hover_text_color": "$primary_button_hover_text_color",
        "$pressed_text_color": "$primary_button_pressed_text_color",
        "$default_button_texture": "textures/buttons/primary/default",
        "$hover_button_texture": "textures/buttons/primary/hover",
        "$pressed_button_texture": "textures/buttons/primary/pressed",
        "$locked_button_texture": "textures/buttons/locked"
    },

    "secondary_button@common_button_template": {
        "$default_text_color": "$secondary_button_default_text_color",
        "$hover_text_color": "$secondary_button_hover_text_color",
        "$pressed_text_color": "$secondary_button_pressed_text_color",
        "$default_button_texture": "textures/buttons/secondary/default",
        "$hover_button_texture": "textures/buttons/secondary/hover",
        "$pressed_button_texture": "textures/buttons/secondary/pressed",
        "$locked_button_texture": "textures/buttons/locked"
    },

    "danger_button@common_button_template": {
        "$default_text_color": "$danger_button_default_text_color",
        "$hover_text_color": "$danger_button_hover_text_color",
        "$pressed_text_color": "$danger_button_pressed_text_color",
        "$default_button_texture": "textures/buttons/danger/default",
        "$hover_button_texture": "textures/buttons/danger/hover",
        "$pressed_button_texture": "textures/buttons/danger/pressed",
        "$locked_button_texture": "textures/buttons/locked"
    }
}
