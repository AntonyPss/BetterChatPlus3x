                ]
            },
            {
                "control_name": "send_button",
                "operation": "insert_before",
                "value": [
                    {
                        "chat_buttons_panel": {
                            "type": "stack_panel",
                            "orientation": "horizontal",
                            "size": ["100%c", "100%"],
                            "bindings": [
                                {
