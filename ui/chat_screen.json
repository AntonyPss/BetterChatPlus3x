                                        "$pressed_button_name": "button.chat_autocomplete",
                                        "$button_content": "chat.icon_up_auto",
                                        "$text_color": [0.12, 0.12, 0.12],
                                        "size": ["100%y", "100%"]
                                    }
                                },
                                {
                                    "chat_autocomplete_back_button@chat.content_button": {
                                        "$pressed_button_name": "button.chat_autocomplete_back",
